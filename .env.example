# AMD Developer Cloud: your own vLLM server on an MI300X droplet
AMD_VLLM_BASE_URL=http://<droplet-ip>:8000/v1
AMD_VLLM_MODEL=
# Start vLLM with --api-key so the public port is not open to anyone; same value here
AMD_VLLM_API_KEY=
# Fireworks AI (if AMD credits are claimed there)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Evolus (app.evolus.ai → Your company → API keys): application key + space id
EVOLUS_API_KEY=
EVOLUS_APP_ID=
# Personal user API key (Evolus profile): needed only to create the knowledge library
EVOLUS_USER_API_KEY=
